# Copy to .env and fill in. NEVER commit .env.
# The app fails fast at boot if a required variable is missing.

# ---- Core ----
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://pgplatform:localdev@localhost:55432/pgplatform?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Codes a single number may request per hour. Keep this low in production —
# it is what stops someone OTP-bombing a tenant's phone. Raise it in local
# .env only, or repeated sign-ins while testing will lock you out.
OTP_MAX_REQUESTS_PER_WINDOW=5
# The window that limit applies over, per phone number.
OTP_REQUEST_WINDOW_SECONDS=3600

# ---- Encryption ----
# 32-byte key, base64url. Encrypts bank account numbers at the column level.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FIELD_ENCRYPTION_KEY=replace-me-32-bytes-base64url

# ---- Razorpay (milestone 2) ----
# Route splits payment at source: the owner's share settles directly to their
# linked account, the platform fee to ours. We never hold funds.
# dev returns a signed fake webhook so the whole booking flow can be exercised
# without an account. The app refuses to start with dev in production.
PAYMENT_GATEWAY=dev
# Signs the development gateway's webhooks. Irrelevant once PAYMENT_GATEWAY=razorpay.
DEV_WEBHOOK_SECRET=dev-webhook-secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Commission in basis points. 400 = 4%.
# Days after move-in that a check-in is still accepted, and when the
# no-show sweep settles an un-scanned booking.
CHECKIN_GRACE_DAYS=7
# How long a bed is held while the tenant pays.
BOOKING_HOLD_MINUTES=15
# How long an owner has to accept a paid booking before it lapses and refunds.
BOOKING_APPROVAL_HOURS=12

PLATFORM_COMMISSION_BPS=400
# Tenant-side convenience fee in paise. 2500 = Rs 25.
PLATFORM_CONVENIENCE_FEE_PAISE=2500

# ---- Photo storage ----
# `local` writes to disk and is for development only — a container filesystem
# is replaced on every deploy, so uploaded photos would be lost. The app
# refuses to boot with local storage when NODE_ENV=production.
#
# `s3` covers Cloudflare R2 (the deployment plan's choice — see docs/03 §8.4),
# AWS S3, and anything else speaking the same protocol.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/media
STORAGE_MAX_UPLOAD_BYTES=8000000
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Required when STORAGE_DRIVER=s3.
# For Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=1
# For AWS S3:
#   S3_ENDPOINT=https://s3.<region>.amazonaws.com
#   S3_REGION=<region>
#   S3_FORCE_PATH_STYLE=0
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pgplatform-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1

# ---- Notifications (milestone 2) ----
# SMS needs DLT registration; WhatsApp needs template approval. Both take weeks.
# Not wired to anything yet — no message of any kind is sent.
#SMS_PROVIDER_KEY=
#WHATSAPP_PROVIDER_KEY=
#FCM_SERVICE_ACCOUNT_JSON=

# ---- Maps (milestone 2) ----
#GOOGLE_MAPS_SERVER_KEY=
